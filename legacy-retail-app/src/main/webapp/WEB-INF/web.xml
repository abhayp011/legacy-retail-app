<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="3.1">
  <display-name>Acme Retail</display-name>

  <resource-ref>
    <res-ref-name>jdbc/RetailDS</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.acme.retail.auth.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>

  <servlet><servlet-name>login</servlet-name><servlet-class>com.acme.retail.auth.LoginServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>login</servlet-name><url-pattern>/login</url-pattern></servlet-mapping>

  <servlet><servlet-name>customers</servlet-name><servlet-class>com.acme.retail.customer.CustomerServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>customers</servlet-name><url-pattern>/api/customers</url-pattern></servlet-mapping>

  <servlet><servlet-name>products</servlet-name><servlet-class>com.acme.retail.product.ProductServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>products</servlet-name><url-pattern>/api/products</url-pattern></servlet-mapping>

  <servlet><servlet-name>orders</servlet-name><servlet-class>com.acme.retail.order.OrderServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>orders</servlet-name><url-pattern>/api/orders</url-pattern></servlet-mapping>

  <servlet><servlet-name>billing</servlet-name><servlet-class>com.acme.retail.billing.BillingServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>billing</servlet-name><url-pattern>/api/billing</url-pattern></servlet-mapping>

  <servlet><servlet-name>reports</servlet-name><servlet-class>com.acme.retail.report.ReportServlet</servlet-class></servlet>
  <servlet-mapping><servlet-name>reports</servlet-name><url-pattern>/api/reports</url-pattern></servlet-mapping>

  <session-config><session-timeout>30</session-timeout></session-config>
</web-app>
